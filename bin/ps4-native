#!/usr/bin/env python3
# universal ps4 native runner and compiler cli
import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SCRIPTS = ROOT / "scripts"
OUT = ROOT / "out"
BIN = ROOT / "bin"

sys.path.insert(0, str(SCRIPTS))
import pkg
import prepare
import link_modules


def run_cmd(cmd, env=None, check=True):
    # execute shell command
    return subprocess.run(cmd, env=env, check=check)


def read_sfo(game_dir: Path):
    # parse sfo metadata
    sfo_path = game_dir / "sce_sys/param.sfo"
    if not sfo_path.exists():
        return {}
    try:
        return prepare.sfo(sfo_path.read_bytes())
    except Exception:
        return {}


def slugify_title(title: str, title_id: str = "") -> str:
    # convert game title to executable slug
    clean = re.sub(r"[^\w\s-]", "", title.lower())
    clean = re.sub(r"[-\s]+", "_", clean).strip("_")
    return clean or (title_id.lower() if title_id else "ps4_game")


def extract_targets(targets, out_dir: Path = None):
    # scan for pkg files and extract in dependency order
    found = pkg.scan_pkgs(targets)
    if not found:
        raise FileNotFoundError(f"no valid ps4 .pkg files found in {targets}")

    # determine title id for destination folder
    title_id = "unknown_game"
    for item in found:
        if item.get("title_id") and item["title_id"] != "Unknown":
            title_id = item["title_id"]
            break

    dest = out_dir or (ROOT / "extracted" / title_id)
    return pkg.extract_pkgs(found, dest)


def inspect_game(target: Path):
    # inspect pkg folder or extracted game directory
    if not target.exists():
        raise FileNotFoundError(f"target path not found: {target}")

    # check if target contains pkg files
    pkg_list = pkg.scan_pkgs(target)
    if pkg_list:
        sorted_pkgs = pkg.sort_pkgs_for_extraction(pkg_list)
        print(f"\n--- ps4 package bundle ({len(sorted_pkgs)} package{'s' if len(sorted_pkgs) != 1 else ''}) ---")
        for idx, item in enumerate(sorted_pkgs, 1):
            size_gb = item["size"] / (1024 ** 3)
            size_str = f"{size_gb:.2f} GB" if size_gb >= 1.0 else f"{item['size'] / (1024**2):.1f} MB"
            print(f"[{idx}] {item['name']}")
            print(f"    type:     {item['label']}")
            print(f"    title:    {item['title']}")
            print(f"    title id: {item['title_id']}")
            print(f"    version:  v{item['app_ver']}")
            print(f"    size:     {size_str}")

    # check if target or extracted dir has eboot
    eboot = None
    game_dir = None
    if target.is_dir() and (target / "eboot.bin").exists():
        game_dir = target
        eboot = target / "eboot.bin"
    elif pkg_list:
        # check if already extracted in extracted/<title_id>
        for item in pkg_list:
            cand = ROOT / "extracted" / item["title_id"]
            if (cand / "eboot.bin").exists():
                game_dir = cand
                eboot = cand / "eboot.bin"
                break

    if not eboot:
        if not pkg_list:
            print(f"note: eboot.bin not found directly in {target}")
        return

    print(f"\n--- extracted binary analysis ({game_dir}) ---")
    sfo_data = read_sfo(game_dir)
    print(f"title:    {sfo_data.get('TITLE', 'unknown')}")
    print(f"title id: {sfo_data.get('TITLE_ID', 'unknown')}")
    print(f"version:  {sfo_data.get('APP_VER', 'unknown')}")

    raw = eboot.read_bytes()
    elf, header, ph, segments, missing = prepare.parse_self(raw)
    loads = [p for p in ph if p['type'] in (1, 0x61000010)]
    size = max(p['vaddr'] + p['memsz'] for p in loads)
    print(f"architecture:      x86_64 (native amd64)")
    print(f"entry point:       {header[4]:#x}")
    print(f"memory image size: {size:,} bytes ({size / (1024*1024):.1f} MiB)")
    print(f"segments:          {len(ph)} total ({len(loads)} loadable)")

    # check sce_module prx
    modules_dir = game_dir / "sce_module"
    prxs = sorted(p.name for p in modules_dir.glob("*.prx")) if modules_dir.exists() else []
    print(f"bundled modules:   {', '.join(prxs) if prxs else 'none'}")

    linkable = []
    for prx in prxs:
        try:
            m = link_modules.module(modules_dir / prx)
            linkable.append((prx, len(m['symbols'])))
        except Exception:
            pass
    print(f"linkable modules:  {len(linkable)} of {len(prxs)}")
    for name, sym_count in linkable:
        print(f"  - {name}: {sym_count} symbols")


def create_launcher_script(game_dir: Path, target_path: Path, title: str = ""):
    # write standalone launcher executable
    target_path.parent.mkdir(parents=True, exist_ok=True)
    boot_bin = OUT / "boot-linked.bin"
    launcher_code = f"""#!/usr/bin/env bash
# native ps4 application launcher for {title or target_path.name}
set -euo pipefail
HERE="$(cd -- "$(dirname -- "$0")" && pwd)"
RUNTIME="$HERE/out/ps4-runtime"
BOOT="$HERE/out/boot-linked.bin"
APP0="{game_dir.resolve()}"
USER_DIR="$HERE/user"

if [[ ! -x "$RUNTIME" ]]; then
    echo "runtime missing; building..."
    bash "$HERE/build.sh"
fi

mkdir -p "$USER_DIR"
export SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1
exec "$RUNTIME" "$BOOT" --app0 "$APP0" --user "$USER_DIR" "$@"
"""
    target_path.write_text(launcher_code)
    target_path.chmod(0o755)
    rel_path = f"./{target_path.relative_to(ROOT)}" if target_path.is_relative_to(ROOT) else str(target_path)
    print(f"standalone executable created: {rel_path}")


def create_desktop_entry(game_dir: Path, slug: str = None, title: str = None):
    # generate xdg desktop application shortcut
    sfo = read_sfo(game_dir)
    game_title = title or sfo.get("TITLE", "PS4 Game")
    title_id = sfo.get("TITLE_ID", "")
    game_slug = slug or slugify_title(game_title, title_id)

    launcher_bin = ROOT / game_slug
    if not launcher_bin.exists():
        create_launcher_script(game_dir, launcher_bin, title=game_title)

    apps_dir = Path.home() / ".local/share/applications"
    apps_dir.mkdir(parents=True, exist_ok=True)
    icon_path = game_dir / "sce_sys/icon0.png"

    lines = [
        "[Desktop Entry]",
        "Type=Application",
        f"Name={game_title}",
        f"Comment=Play {game_title} natively on Linux",
        f"Exec={launcher_bin.resolve()}",
        f"Path={ROOT.resolve()}",
        "Terminal=false",
        "Categories=Game;",
    ]
    if icon_path.exists():
        lines.append(f"Icon={icon_path.resolve()}")

    desktop_file = apps_dir / f"{game_slug}.desktop"
    desktop_file.write_text("\n".join(lines) + "\n")
    print(f"desktop launcher installed: {desktop_file}")
    return desktop_file


def compile_game(game_dir: Path, out_dir: Path = OUT, app_out: Path = None):
    # prepare eboot and link modules into native binary
    out_dir.mkdir(parents=True, exist_ok=True)
    eboot = game_dir / "eboot.bin"
    if not eboot.exists():
        raise FileNotFoundError(f"eboot.bin not found in {game_dir}")

    print(f"preparing native image from {eboot}...")
    prepare.prepare(game_dir, out_dir)

    # find modules to link
    sce_module = game_dir / "sce_module"
    modules_to_link = []
    if sce_module.exists():
        for candidate in ("libc.prx", "libSceFios2.prx"):
            if (sce_module / candidate).is_file():
                modules_to_link.append(candidate)

    print(f"linking modules: {modules_to_link}...")
    link_modules.link(game_dir, out_dir, module_names=tuple(modules_to_link))
    boot_bin = out_dir / "boot-linked.bin"
    print(f"native compilation successful: {boot_bin}")

    # automatically generate standalone title launcher
    sfo = read_sfo(game_dir)
    title = sfo.get("TITLE", "")
    title_id = sfo.get("TITLE_ID", "")
    slug = slugify_title(title, title_id)
    launcher_path = Path(app_out) if app_out else (ROOT / slug)
    create_launcher_script(game_dir, launcher_path, title=title)

    return boot_bin


def resolve_game_dir(target: Path, rebuild: bool = False) -> Path:
    # resolve game directory from path pkg or folder of pkgs
    if target.is_dir() and (target / "eboot.bin").exists():
        return target

    # scan for pkgs if target is pkg or directory
    pkgs = pkg.scan_pkgs(target)
    if pkgs:
        # get title id
        title_id = "unknown_game"
        for item in pkgs:
            if item.get("title_id") and item["title_id"] != "Unknown":
                title_id = item["title_id"]
                break
        dest = ROOT / "extracted" / title_id
        if not (dest / "eboot.bin").exists() or rebuild:
            print(f"target requires extraction to {dest}")
            pkg.extract_pkgs(pkgs, dest)
        return dest

    raise FileNotFoundError(f"could not find game binary or valid pkgs in {target}")


def run_game(target: Path, args, unknown_args):
    # build runtime if not built
    runtime_bin = OUT / "ps4-runtime"
    if not runtime_bin.exists():
        print("runtime binary missing; running build.sh...")
        run_cmd(["bash", str(ROOT / "build.sh")])

    game_dir = resolve_game_dir(target, args.rebuild)

    boot_bin = OUT / "boot-linked.bin"
    if not boot_bin.exists() or args.rebuild:
        compile_game(game_dir, OUT)

    cmd = [
        str(runtime_bin),
        str(boot_bin),
        "--app0", str(game_dir.resolve()),
        "--user", str(args.user_dir or (ROOT / "user").resolve()),
        "--timeout", str(args.timeout),
    ]

    if args.cpu_only:
        cmd.append("--cpu-only")
    if args.permissive:
        cmd.append("--permissive")

    cmd.extend(unknown_args)

    env = os.environ.copy()
    if args.permissive:
        env["PS4_PERMISSIVE"] = "1"
    env["SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS"] = "1"

    print(f"launching native ps4 app: {' '.join(cmd)}")
    return run_cmd(cmd, env=env, check=False).returncode


def main():
    parser = argparse.ArgumentParser(
        description="Universal PS4 Native Runtime & Compiler on Linux"
    )
    sub = parser.add_subparsers(dest="command", required=True)

    # extract
    p_ext = sub.add_parser("extract", help="extract a ps4 .pkg file, multiple files, or directory of pkgs")
    p_ext.add_argument("targets", type=Path, nargs="+", help="path(s) to .pkg file(s) or directory containing pkgs")
    p_ext.add_argument("--out", type=Path, default=None, help="output directory (defaults to extracted/<TITLE_ID>)")

    # inspect
    p_ins = sub.add_parser("inspect", help="inspect ps4 pkg(s), directory of pkgs, or extracted game directory")
    p_ins.add_argument("target", type=Path, help="path to .pkg, folder of pkgs, or extracted game directory")

    # compile
    p_cmp = sub.add_parser("compile", help="compile/link ps4 eboot to native binary")
    p_cmp.add_argument("game_dir", type=Path, help="extracted game directory")
    p_cmp.add_argument("--out", type=Path, default=OUT, help="output directory")
    p_cmp.add_argument("--app-out", type=Path, default=None, help="standalone executable launcher path")

    # desktop
    p_dsk = sub.add_parser("desktop", help="install a desktop shortcut with game icon to application menu")
    p_dsk.add_argument("game_dir", type=Path, help="extracted game directory")

    # run
    p_run = sub.add_parser("run", help="run a ps4 game natively from folder, .pkg, or directory of pkgs")
    p_run.add_argument("target", type=Path, help="path to game directory, .pkg, or folder of pkgs")
    p_run.add_argument("--cpu-only", action="store_true", help="run without vulkan gpu window")
    p_run.add_argument("--permissive", action="store_true", help="stub unhandled imports with 0")
    p_run.add_argument("--timeout", type=int, default=0, help="timeout in seconds (0 = unlimited)")
    p_run.add_argument("--user-dir", type=Path, default=None, help="user saves directory")
    p_run.add_argument("--rebuild", action="store_true", help="force recompile before running")

    args, unknown = parser.parse_known_args()

    if args.command == "extract":
        extract_targets(args.targets, out_dir=args.out)
    elif args.command == "inspect":
        inspect_game(args.target)
    elif args.command == "compile":
        compile_game(args.game_dir, args.out, app_out=args.app_out)
    elif args.command == "desktop":
        create_desktop_entry(args.game_dir)
    elif args.command == "run":
        code = run_game(args.target, args, unknown)
        sys.exit(code)


if __name__ == "__main__":
    main()
